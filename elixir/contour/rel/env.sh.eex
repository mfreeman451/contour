#!/bin/sh
if [ "${CLUSTER_ENABLED:-false}" = "true" ]; then
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="contour@${POD_IP:?POD_IP is required for distribution}"
  : "${RELEASE_COOKIE:?RELEASE_COOKIE is required for distribution}"
  if [ "${DISTRIBUTION_TLS:-true}" = "true" ]; then
    export ERL_FLAGS="${ERL_FLAGS:-} -proto_dist inet_tls -ssl_dist_optfile /etc/contour/distribution-options/ssl_dist.conf"
  fi
else
  export RELEASE_DISTRIBUTION=none
fi
export ERL_CRASH_DUMP=/tmp/erl_crash.dump
