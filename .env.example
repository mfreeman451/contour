# Optional Google credentials for local development; copy to .env (gitignored).
# Create a Google Web application OAuth client with this exact redirect URI.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=http://localhost:4000/auth/google/callback

# scripts/dev loads the generated .local/postgres.env database credentials.
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=55432
# DATABASE_NAME=contour_dev
