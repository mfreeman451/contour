#!/usr/bin/env python3
"""Refresh pinned npm artifacts from the independent frontend lockfile."""
import json
from pathlib import Path

root = Path(__file__).resolve().parent.parent
manifest = root / "web/npm_packages.bzl"
entries = json.loads(manifest.read_text().split("NPM_PACKAGES = ", 1)[1])
lock = json.loads((root / "web/package-lock.json").read_text())
for entry in entries:
    package = lock["packages"]["node_modules/" + entry["package"]]
    entry["url"] = package["resolved"]
    entry["integrity"] = package["integrity"]
manifest.write_text(
    "# Generated from package-lock.json; regenerate with scripts/npm-bazel.\n"
    + "NPM_PACKAGES = " + json.dumps(entries, indent=4) + "\n"
)
