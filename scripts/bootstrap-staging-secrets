#!/usr/bin/env python3
"""Create staging secrets from a private env file. Values never go on command lines."""
import base64
import json
import secrets
import shlex
import subprocess
import sys
from pathlib import Path

if len(sys.argv) != 2:
    sys.exit("Usage: scripts/bootstrap-staging-secrets .local/staging.env")
values = {}
for line in Path(sys.argv[1]).read_text().splitlines():
    if not line.strip() or line.lstrip().startswith("#"):
        continue
    key, separator, raw = line.partition("=")
    if not separator:
        sys.exit("Expected KEY=value entries in the secret input file")
    parts = shlex.split(raw, comments=True)
    values[key.strip()] = " ".join(parts)
for key in ["GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "HARBOR_USERNAME", "HARBOR_PASSWORD"]:
    if not values.get(key):
        sys.exit("Missing required secret: " + key)

kubectl = ["kubectl", "--context", "farm01", "--namespace", "contour-staging"]

def apply(resource):
    subprocess.run(kubectl + ["apply", "-f", "-"], input=json.dumps(resource), text=True, check=True)

apply({"apiVersion": "v1", "kind": "Namespace", "metadata": {"name": "contour-staging", "labels": {
    "pod-security.kubernetes.io/enforce": "restricted", "pod-security.kubernetes.io/audit": "restricted", "pod-security.kubernetes.io/warn": "restricted"
}}})

def existing(name):
    result = subprocess.run(kubectl + ["get", "secret", name, "--ignore-not-found", "-o", "json"], capture_output=True, text=True, check=True)
    if not result.stdout.strip():
        return {}
    return {key: base64.b64decode(value).decode() for key, value in json.loads(result.stdout).get("data", {}).items()}

def secret(name, data, secret_type="Opaque"):
    apply({"apiVersion": "v1", "kind": "Secret", "metadata": {"name": name}, "type": secret_type, "stringData": data})

database = existing("contour-db-credentials")
secret("contour-db-credentials", {"username": "contour", "password": values.get("DATABASE_PASSWORD") or database.get("password") or secrets.token_hex(32)}, "kubernetes.io/basic-auth")
cluster = existing("contour-cluster-secrets")
secret("contour-cluster-secrets", {"RELEASE_COOKIE": cluster.get("RELEASE_COOKIE") or secrets.token_hex(32)})
web = existing("contour-web-secrets")
secret("contour-web-secrets", {
    "SECRET_KEY_BASE": web.get("SECRET_KEY_BASE") or secrets.token_urlsafe(64),
    "GUARDIAN_SECRET_KEY": web.get("GUARDIAN_SECRET_KEY") or secrets.token_urlsafe(64),
    "GOOGLE_CLIENT_ID": values["GOOGLE_CLIENT_ID"], "GOOGLE_CLIENT_SECRET": values["GOOGLE_CLIENT_SECRET"],
    "OIDC_REDIRECT_URI": "https://contour.k8s-farm.carverauto.dev/auth/google/callback"
})
auth = base64.b64encode((values["HARBOR_USERNAME"] + ":" + values["HARBOR_PASSWORD"]).encode()).decode()
secret("contour-registry", {".dockerconfigjson": json.dumps({"auths": {"registry.carverauto.dev": {"auth": auth}}})}, "kubernetes.io/dockerconfigjson")
