#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

engine=${CONTAINER_ENGINE:-container}
case "$engine" in container|docker) ;; *) echo 'CONTAINER_ENGINE must be container or docker' >&2; exit 1 ;; esac
name=contour-postgres
volume=contour-postgres-data
image=ghcr.io/cloudnative-pg/postgresql:18.6-202609281634-system-bookworm@sha256:dc7fa2b7418ac5a3c0b25514f70fcdce52b16c3b0eacfc9dd006143adfb0f7c0

case "${1:-up}" in
  up)
    mkdir -p .local
    if [ ! -f .local/postgres.env ]; then
      python3 - <<'PY'
import os, secrets
path = '.local/postgres.env'
with os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), 'w') as f:
    f.write('POSTGRES_USER=contour\nPOSTGRES_PASSWORD=' + secrets.token_hex(32) + '\nPGDATA=/var/lib/postgresql/data/pgdata\n')
PY
    fi
    if "$engine" inspect "$name" >/dev/null 2>&1; then
      if ! "$engine" exec "$name" pg_isready -U contour >/dev/null 2>&1; then
        "$engine" start "$name" >/dev/null
      fi
    else
      if ! "$engine" volume inspect "$volume" >/dev/null 2>&1; then
        "$engine" volume create "$volume" >/dev/null
      fi
      "$engine" run --detach --name "$name" --user 0:0 --cpus 2 --memory 1G \
        --publish 127.0.0.1:55432:5432 --env-file "$PWD/.local/postgres.env" \
        --mount "type=volume,source=$volume,target=/var/lib/postgresql/data" \
        --mount "type=bind,source=$PWD/scripts,target=/bootstrap,readonly" \
        --entrypoint /bin/bash "$image" /bootstrap/postgres-entrypoint.sh >/dev/null
    fi
    for _ in {1..60}; do
      if "$engine" exec "$name" pg_isready -U contour >/dev/null 2>&1; then
        echo 'PostgreSQL ready at 127.0.0.1:55432 (persistent volume contour-postgres-data)'
        exit 0
      fi
      sleep 1
    done
    echo 'PostgreSQL did not become ready; inspect scripts/db logs' >&2
    exit 1
    ;;
  stop) "$engine" stop "$name" ;;
  logs) "$engine" logs "$name" ;;
  status) "$engine" exec "$name" pg_isready -U contour ;;
  *) echo 'Usage: scripts/db [up|stop|logs|status]' >&2; exit 1 ;;
esac
