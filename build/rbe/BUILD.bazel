platform(
    name = "platform",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@bazel_tools//tools/cpp:gcc",
        "@erlang_config//:erlang_internal",
        "@elixir_config//:elixir_internal",
    ],
    exec_properties = {
        "OSFamily": "Linux",
        "Arch": "amd64",
        "dockerNetwork": "host",
        # Shared build-tools image; PostgreSQL compilation needs GCC/make/bison/flex.
        "container-image": "docker://registry.carverauto.dev/serviceradar/rbe-executor:v1.0.25.1@sha256:779e9889e18fd8c7a3372d79a130c3d346205fcbfc8190d12c8393b88692dfa5",
    },
    visibility = ["//visibility:public"],
)
