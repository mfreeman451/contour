module(name = "contour", version = "0.1.0")

bazel_dep(name = "rules_erlang", version = "3.19.0")
bazel_dep(name = "rules_elixir", version = "1.3.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "llvm", version = "0.8.18")

llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")
llvm.version(llvm_version = "22.1.6")
use_repo(llvm, "llvm-project")
register_toolchains("@llvm//toolchain:all")

# Pinned Erlang/Elixir rule revisions, with project-owned inputs.
git_override(
    module_name = "rules_erlang",
    commit = "effba3214d0e5637c66430cad67d59810ce8f1c3",
    remote = "https://github.com/bazelverse/rules_erlang.git",
)
git_override(
    module_name = "rules_elixir",
    commit = "31e99980a43598211d2a6c5fbb893a21a9c0644b",
    remote = "https://github.com/bazelverse/rules_elixir.git",
)

erlang = use_extension("@rules_erlang//bzlmod:extensions.bzl", "erlang_config")
erlang.prebuilt_erlang_from_hex_builds(
    name = "otp_29_1_1",
    arch = "amd64",
    os = "ubuntu-24.04",
    version = "29.1.1",
    sha256 = "35186bdae840028df621d14f3a75c68eb52eea90fabd500f7946a5d74bdaf11b",
    exec_compatible_with = ["@platforms//os:linux"],
)
erlang.internal_erlang_from_github_release(
    name = "otp_29_1_1_darwin",
    version = "29.1.1",
    sha256 = "054e0143e39c780e091107fc9b345792a9c1a55f6bac1eca1c1101510fc06bf6",
    exec_compatible_with = ["@platforms//os:macos"],
)
use_repo(erlang, "erlang_config")

elixir = use_extension("@rules_elixir//bzlmod:extensions.bzl", "elixir_config")
elixir.prebuilt_elixir_from_hex_builds(
    name = "elixir_1_20_4",
    version = "1.20.4",
    otp_major = "29",
    sha256 = "7863c546cda13fecc949e562e326042451dacf8fd8698a36783cb71eeb223b46",
)
use_repo(elixir, "elixir_config")
hex_archive = use_extension("@rules_elixir//bzlmod:extensions.bzl", "hex")
hex_archive.from_github_release(version = "2.5.1", sha256 = "dabd99ea48ba8064c32bc2e97d59ab1b1055a38a1dd178c5389d95c35e985d2d")
use_repo(hex_archive, "hex")
hex_packages = use_extension("//third_party/hex:extensions.bzl", "hex")
use_repo(hex_packages, "hexpm")

register_toolchains(
    "@erlang_config//otp_29_1_1:toolchain_major",
    "@erlang_config//otp_29_1_1:toolchain_major_minor",
    "@erlang_config//otp_29_1_1_darwin:toolchain_major",
    "@erlang_config//otp_29_1_1_darwin:toolchain_major_minor",
    "@elixir_config//elixir_1_20_4:toolchain",
    "//build:mix_payloads",
)

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "postgresql_src", urls = ["https://ftp.postgresql.org/pub/source/v18.6/postgresql-18.6.tar.bz2"],
    sha256 = "555610c24d53e4316da5b7d3fc25c279d96856d5e0e23ee308c328c5fa881d9f",
    strip_prefix = "postgresql-18.6", build_file_content = 'exports_files(["configure"])\nfilegroup(name="srcs", srcs=glob(["**"], exclude=["BUILD.bazel"]), visibility=["//visibility:public"])',
)
http_archive(
    name = "node_linux", urls = ["https://nodejs.org/dist/v22.23.2/node-v22.23.2-linux-x64.tar.xz"],
    sha256 = "d60acfe00a2932254bb0ad20e01b0d74397a0875595de719654b214f4b03f307",
    strip_prefix = "node-v22.23.2-linux-x64", build_file_content = 'exports_files(["bin/node"])',
)
http_archive(
    name = "node_darwin", urls = ["https://nodejs.org/dist/v22.23.2/node-v22.23.2-darwin-arm64.tar.xz"],
    sha256 = "5eff7a9011895aae3f29d06f167b84a62b028a591370c7cafb59103559fd26e1",
    strip_prefix = "node-v22.23.2-darwin-arm64", build_file_content = 'exports_files(["bin/node"])',
)
http_file(
    name = "tailwind_linux", urls = ["https://github.com/tailwindlabs/tailwindcss/releases/download/v4.3.0/tailwindcss-linux-x64"],
    sha256 = "73f0e5459054e5cfaa8ab6f3b940f3fbe0f13cc7fd83bc24e7c655033c203400", executable = True,
)
http_file(
    name = "tailwind_darwin", urls = ["https://github.com/tailwindlabs/tailwindcss/releases/download/v4.3.0/tailwindcss-macos-arm64"],
    sha256 = "56b4bbc62dbdc4614a78930d9c6986423a2ec63e4e640144a59a5d95c914322e", executable = True,
)
npm = use_extension("//web:npm.bzl", "npm")
use_repo(npm, "npm_typescript_linux", "npm_typescript_darwin", "npm_typescript", "npm_phoenix", "npm_phoenix_html", "npm_phoenix_live_view", "npm_types_phoenix", "npm_types_phoenix_live_view", "npm_esbuild_linux", "npm_esbuild_darwin")
http_file(
    name = "lazy_html_linux",
    urls = ["https://github.com/dashbitco/lazy_html/releases/download/v0.1.13/lazy_html-nif-2.16-x86_64-linux-gnu-0.1.13.tar.gz"],
    sha256 = "e0b6e74e3dae955fec2f8aaa306c53599454aa498921024abd255c59aa5f969b",
    downloaded_file_path = "lazy_html-nif-2.16-x86_64-linux-gnu-0.1.13.tar.gz",
)
http_file(
    name = "lazy_html_darwin",
    urls = ["https://github.com/dashbitco/lazy_html/releases/download/v0.1.13/lazy_html-nif-2.16-aarch64-apple-darwin-0.1.13.tar.gz"],
    sha256 = "563b739137af91f5078ff794b259e5b8c259136c7dbc63db562721dabe176fe3",
    downloaded_file_path = "lazy_html-nif-2.16-aarch64-apple-darwin-0.1.13.tar.gz",
)
